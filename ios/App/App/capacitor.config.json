{
	"appId": "com.awladselim.erp",
	"appName": "AWLAD SELIM",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#0f172a",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#1e3a8a"
		},
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"FilesystemPlugin",
		"GeolocationPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"SplashScreenPlugin"
	]
}
