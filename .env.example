# Server Port (Windows 10 / LAN Server)
PORT=3000
API_PORT=3000
TRUST_PROXY=1

# Central Data Directory (Optional override for shop laptop central server)
# Default uses user data dir in Electron or ./server/data in standalone mode
AWLAD_DATA_DIR=""

# Security & Mobile CORS
# Leave ALLOWED_ORIGINS empty for LAN use, or comma-separate HTTPS origins
# Capacitor native origins (capacitor://localhost, https://localhost, ionic://localhost) are always allowed
JWT_SECRET=""
ALLOWED_ORIGINS=""
ALLOW_MOBILE_LAN_HTTP=true

# PostgreSQL Connection (Leave empty until PostgreSQL is installed & configured)
# Option A: Full connection string (DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/awlad_selim")
DATABASE_URL=""

# Option B: Individual parameters (Windows 10 local PostgreSQL)
# Leave PGHOST empty to run safely on local JSON ledger until PostgreSQL is ready
PGHOST=""
PGPORT=5432
PGUSER=""
PGPASSWORD=""
PGDATABASE="awlad_selim"
PG_SSL="false"

# Optional one-time initial admin bootstrap (only runs when 0 users exist)
ADMIN_INITIAL_FULL_NAME=""
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""

# Optional Gemini / App URL
GEMINI_API_KEY=""
APP_URL=""
