{
  "name": "awlad-selim",
  "private": true,
  "version": "3.0.0",
  "description": "AWLAD SELIM - نظام أولاد سليم للمحاسبة وإدارة الأعمال",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "server:start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-electron','server.js'])fs.rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "electron:icons": "node scripts/generate-win-icon.mjs",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run clean && npm run build && npm run electron:icons && electron-builder --win --x64 --dir",
    "electron:dist": "npm run clean && npm run build && npm run electron:icons && electron-builder --win nsis portable --x64 --publish never",
    "electron:portable": "npm run build && npm run electron:icons && electron-builder --win portable --x64 --publish never",
    "windows:customer-zip": "node scripts/package-windows-customer-zip.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap sync android",
    "cap:ios": "npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/cairo": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "app-builder-lib>minimatch": "^11.0.9",
    "@electron/universal>minimatch": "^11.0.9"
  },
  "author": "AWLAD SELIM",
  "build": {
    "appId": "com.awladselim.erp",
    "productName": "AWLAD SELIM",
    "copyright": "Copyright © 2026 AWLAD SELIM",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/assets/aistudio/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/tests/**/*",
      "!server/data/**/*",
      "!android/**/*",
      "!ios/**/*",
      "!.env",
      "!.env.*",
      "!**/.jwt_secret",
      "!**/database.json",
      "!**/sessions.json",
      "!**/audit_logs.json",
      "!**/idempotency.json",
      "!**/migration_logs.json",
      "!*.db",
      "!*.sqlite",
      "!*.sqlite3",
      "build/icon.*",
      "package.json"
    ],
    "asar": false,
    "compression": "store",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "AWLAD SELIM",
      "artifactName": "AWLAD-SELIM-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AWLAD-SELIM-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AWLAD SELIM",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
